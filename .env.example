# Only local Sandbox payments are supported. No live endpoint exists in the code.
APP_URL=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Leave these empty/false for the free offline demo.
# Use only a Gemini project that has NO billing account attached.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false

# Optional: absolute path to the SQLite file. Default: ./data/fairdeal.sqlite
# FAIRDEAL_DB_PATH=
